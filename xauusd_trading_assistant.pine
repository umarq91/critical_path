//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  XAUUSD TRADING ASSISTANT & DISCIPLINE GUARD  —  v1.0
// ═══════════════════════════════════════════════════════════════════════════════
//  PURPOSE
//    This is NOT a buy/sell indicator. It is an analysis + discipline tool.
//    Its job is to help you take FEWER, BETTER trades and to stop you trading
//    when your own rules say you should stop.
//
//  IT WILL FREQUENTLY SAY "WAIT" OR "NO TRADE". THAT IS THE POINT.
//
//  HONEST LIMITATIONS (read these):
//    1. Pine Script has NO connection to your broker. It cannot know your real
//       P/L, trade count, or losses. Those are MANUAL INPUTS you update in the
//       settings panel. Nothing here is connected to your account.
//    2. Pine Script has no economic calendar. The news filter is a MANUAL switch.
//    3. Order blocks are a heuristic price-action construct. This script does not
//       and cannot see institutional order flow. The algorithm is defined in
//       comments so you know exactly what it does.
//    4. The confluence score is a heuristic checklist total. It is NOT a win
//       probability and must never be read as one.
//    5. Swing pivots are confirmed `Swing Length` bars after the fact. That is a
//       structural delay, not a repaint.
//
//  NON-REPAINTING DESIGN
//    - All request.security() calls use lookahead_off (or lookahead_on with a [1]
//      offset for previous-period levels, which is the standard confirmed form).
//    - "Confirmed Signals Only" = ON uses the previous CLOSED higher-timeframe bar.
//    - Structure breaks, sweeps and FVGs are all evaluated on bar close.
//    - Live/intrabar items (running session & daily range, current zone touch)
//      are marked LIVE in the dashboard.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("XAUUSD Trading Assistant & Discipline Guard", "XAU-TAD", overlay = true,
     max_lines_count = 120, max_labels_count = 120, max_boxes_count = 120)


// ═══════════════════════════════════════════════════════════════════════════════
//  SECTION 1 — INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

string G_GEN  = "1 · General & Timeframes"
string G_MS   = "2 · Market Structure"
string G_LIQ  = "3 · Liquidity"
string G_FVG  = "4 · Fair Value Gaps"
string G_OB   = "5 · Order Blocks"
string G_PD   = "6 · Premium / Discount"
string G_SET  = "7 · Setup Engine"
string G_SCR  = "8 · Confluence Weights"
string G_PLN  = "9 · Entry / Stop / Target"
string G_RSK  = "10 · Risk Calculator"
string G_DAY  = "11 · Daily Discipline (MANUAL)"
string G_SES  = "12 · Sessions"
string G_ADR  = "13 · ADR / Volatility"
string G_NWS  = "14 · News (MANUAL)"
string G_DSH  = "15 · Dashboard"
string G_VIS  = "16 · Visuals & Colours"

// ── General ───────────────────────────────────────────────────────────────────
string iMode        = input.string("Setup Hunting", "Trading Mode", options = ["Analysis", "Setup Hunting", "Trade Plan", "Locked"], group = G_GEN, tooltip = "Analysis = information only.\nSetup Hunting = show setup progress.\nTrade Plan = also draw entry/SL/TP.\nLocked = force everything off.")
string iHTF         = input.timeframe("60", "Higher timeframe (bias)", group = G_GEN)
string iMTF         = input.timeframe("15", "Intermediate timeframe", group = G_GEN)
bool   iConfirmed   = input.bool(true, "Confirmed signals only (use last CLOSED HTF bar)", group = G_GEN, tooltip = "ON = fully non-repainting HTF bias. OFF = live HTF bar, which can change until it closes.")
int    iAgree       = input.int(2, "Timeframes that must agree (of 3)", minval = 1, maxval = 3, group = G_GEN)
int    iAtrLen      = input.int(14, "ATR length", minval = 2, group = G_GEN)
bool   iOverride    = input.bool(false, "⚠ MANUAL OVERRIDE — bypass discipline locks", group = G_GEN, tooltip = "Deliberately inconvenient. Leave OFF. Turning this on disables every protective lock.")

// ── Market structure ──────────────────────────────────────────────────────────
int    iSwingLen    = input.int(5, "Swing length (pivot left/right)", minval = 2, maxval = 50, group = G_MS)
float  iDispMult    = input.float(1.2, "Displacement candle ≥ (× ATR)", minval = 0.1, step = 0.1, group = G_MS)
bool   iShowBOS     = input.bool(true,  "Show BOS", group = G_MS)
bool   iShowCHOCH   = input.bool(true,  "Show CHoCH", group = G_MS)
bool   iShowMSS     = input.bool(true,  "Show MSS", group = G_MS)
bool   iShowSwings  = input.bool(false, "Show HH / HL / LH / LL labels", group = G_MS)
int    iMaxStruct   = input.int(10, "Max structure labels on chart", minval = 2, maxval = 60, group = G_MS)

// ── Liquidity ─────────────────────────────────────────────────────────────────
bool   iShowLiq     = input.bool(true, "Show liquidity levels", group = G_LIQ)
bool   iShowPD      = input.bool(true, "Previous day high / low (PDH / PDL)", group = G_LIQ)
bool   iShowPW      = input.bool(true, "Previous week high / low (PWH / PWL)", group = G_LIQ)
bool   iShowDO      = input.bool(true, "Daily open", group = G_LIQ)
bool   iShowSwingLq = input.bool(true, "Swing high / low (BSL / SSL)", group = G_LIQ)
bool   iShowSessLvl = input.bool(true, "Previous session high / low", group = G_LIQ)
float  iEqTol       = input.float(0.15, "Equal high/low tolerance (× ATR)", minval = 0.01, step = 0.01, group = G_LIQ)
int    iEqMinSep    = input.int(3, "Equal high/low minimum bar separation", minval = 1, group = G_LIQ)
int    iSweepValid  = input.int(20, "Sweep validity (bars)", minval = 3, group = G_LIQ)
