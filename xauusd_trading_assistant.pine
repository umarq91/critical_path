// ── Premium / discount ────────────────────────────────────────────────────────
bool   iShowPDzone  = input.bool(true, "Show premium / discount range", group = G_PD)

// ── Setup engine ──────────────────────────────────────────────────────────────
float  iMinScore    = input.float(75, "Minimum setup score to qualify", minval = 0, maxval = 100, group = G_SET)
float  iMinRR       = input.float(2.0, "Minimum reward : risk", minval = 0.5, step = 0.1, group = G_SET)
int    iExpiry      = input.int(40, "Setup expiry (bars without entry)", minval = 5, group = G_SET)
string iZonePref    = input.string("FVG first", "Entry zone preference", options = ["FVG first", "Order block first"], group = G_SET)

// ── Confluence weights ────────────────────────────────────────────────────────
float  wHTF   = input.float(20, "HTF bias aligned",            group = G_SCR)
float  wMTF   = input.float(10, "Intermediate TF aligned",     group = G_SCR)
