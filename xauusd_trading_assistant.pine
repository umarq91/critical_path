// ── Order blocks ──────────────────────────────────────────────────────────────
bool   iShowOB      = input.bool(true, "Show order blocks", group = G_OB)
string iObMode      = input.string("Body", "Order block zone", options = ["Body", "Full Candle", "Wick"], group = G_OB)
